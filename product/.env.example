# No credentials belong in this repository. Local .env is ignored by Git.
PRODUCT_DB=product-data/product.sqlite3
PRODUCT_HOST=127.0.0.1
PRODUCT_PORT=8765
PRODUCT_WORKER=true
PRODUCT_TEST_BILLING=false
PRODUCT_INTERNAL_RESEARCH=false
PRODUCT_INTERNAL_EMAILS=
PRODUCT_JOB_TIMEOUT=300
# Exact HTTPS front-end origins, comma separated. Never use *.
PRODUCT_CORS_ORIGINS=
# Custom trusted payment adapter contract, NOT WeChat/Alipay native integration.
PRODUCT_BILLING_WEBHOOK_SECRET=
# Optional upstream TradingAgents provider keys go in server environment only.
# OPENAI_API_KEY=

# Public Yahoo historical data for local personal research only.
# Set disabled in commercial deployments until a licensed vendor is integrated.
PRODUCT_PUBLIC_HISTORY=personal
